{
  "name": "zain-studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode worker",
    "build:client": "vite build",
    "build:worker": "vite build --mode worker",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^13.2.0",
    "hono": "^4.13.7",
    "lenis": "^1.3.26",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
